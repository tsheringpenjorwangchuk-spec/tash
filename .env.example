# Copy this file to .env in the project root OR server/.env
# Never commit your real API key.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
PORT=3001

# Email notifications (sent via Gmail SMTP using nodemailer).
# EMAIL_USER must be a full Gmail address.
# EMAIL_APP_PASSWORD must be a 16-character Gmail "App Password"
# (Google Account -> Security -> 2-Step Verification -> App passwords).
# Do NOT use your normal Gmail login password here - it will not work.
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_APP_PASSWORD=your_16_char_app_password
EMAIL_FROM="Lost & Found Office <your_gmail_address@gmail.com>"

# PostgreSQL (optional while using localStorage prototype)
DATABASE_URL=postgresql://username:password@localhost:5432/lost_found
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Frontend migration switch. Keep false while localStorage remains the primary prototype store.
VITE_USE_DATABASE_API=false
VITE_API_BASE_URL=http://localhost:3001
